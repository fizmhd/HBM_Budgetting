{
    "FrontendUrl": "https://localhost:5001",
    "ConnectionStrings": {
        "DefaultConnection": ""
    },
    "Auth": {
        "Provider": "Supabase",
        "Supabase": {
            "Url": "https://test.supabase.co",
            "AnonKey": "test-anon-key",
            "ServiceRoleKey": "test-service-role-key"
        },
        "AccessTokenExpiryMinutes": 15,
        "RefreshTokenExpiryDays": 7,
        "RefreshTokenGracePeriodSeconds": 30
    },
    "Security": {
        "Lockout": {
            "Enabled": false,
            "MaxFailedAttempts": 5,
            "LockoutDurationMinutes": 15,
            "ResetFailedCountAfterMinutes": 15
        },
        "RateLimiting": {
            "Enabled": false,
            "LoginAttemptsPerWindow": 5,
            "LoginWindowMinutes": 15,
            "RegisterAttemptsPerWindow": 3,
            "RegisterWindowHours": 1,
            "GeneralRequestsPerMinute": 100
        },
        "Sessions": {
            "MaxConcurrentSessions": 5,
            "EvictionPolicy": "OldestFirst"
        },
        "Password": {
            "MinLength": 8,
            "RequireUppercase": true,
            "RequireLowercase": true,
            "RequireDigit": true,
            "RequireSpecialChar": true
        },
        "Csrf": {
            "Enabled": false,
            "CookieName": "X-CSRF-TOKEN",
            "HeaderName": "X-CSRF-TOKEN"
        }
    },
    "Session": {
        "TimeoutMinutes": 30,
        "MaxConcurrentSessions": 5
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Warning",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": []
    },
    "ApiVersioning": {
        "DefaultVersion": "1.0",
        "ReportVersions": true
    }
}