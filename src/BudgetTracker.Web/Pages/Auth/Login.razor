@page "/login"
@using BudgetTracker.Shared.DTOs.Auth
@using BudgetTracker.Web.Auth
@using BudgetTracker.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using BudgetTracker.Web.Services.ErrorHandling
@attribute [AllowAnonymous]
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ApiErrorHandler ErrorHandler

<div class="auth-page">
    <div class="auth-card">
        <h2>Login to Budget Tracker</h2>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <ErrorAlert Message="@_errorMessage" />
        }

        <EditForm Model="@_loginRequest" OnValidSubmit="@HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="email">Email</label>
                <InputText id="email" @bind-Value="_loginRequest.Email" class="form-control" placeholder="Enter your email" />
                <ValidationMessage For="@(() => _loginRequest.Email)" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <InputText id="password" type="password" @bind-Value="_loginRequest.Password" class="form-control" placeholder="Enter your password" />
                <ValidationMessage For="@(() => _loginRequest.Password)" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-block" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <LoadingSpinner />
                        <span>Logging in...</span>
                    }
                    else
                    {
                        <span>Login</span>
                    }
                </button>
            </div>
        </EditForm>

        <div class="auth-links">
            <a href="/register">Don't have an account? Register</a>
            <a href="/forgot-password">Forgot password?</a>
        </div>
    </div>
</div>



@code {
    private LoginRequest _loginRequest = new();
    private bool _isLoading = false;
    private string? _errorMessage;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthService.LoginAsync(_loginRequest);

            if (response != null)
            {
                // Notify authentication state changed
                if (AuthStateProvider is BudgetTracker.Web.Auth.AuthStateProvider provider)
                {
                    provider.NotifyAuthenticationStateChanged();
                }

                if (response.User.IsProfileComplete)
                {
                    // Navigate to return URL or home
                    Navigation.NavigateTo(ReturnUrl ?? "/");
                }
                else
                {
                    // Navigate to onboarding
                    Navigation.NavigateTo("/onboarding");
                }
            }
            else
            {
                _errorMessage = "Login failed. Please check your credentials.";
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            _errorMessage = "Invalid email or password. Please try again.";
        }
        catch (Exception ex)
        {
            var errorResult = ErrorHandler.Handle(ex, "Login failed");
            _errorMessage = errorResult.UserMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
