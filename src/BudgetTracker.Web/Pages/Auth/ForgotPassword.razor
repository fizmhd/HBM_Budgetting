@page "/forgot-password"
@using BudgetTracker.Shared.DTOs.Auth
@using BudgetTracker.Web.Services
@using BudgetTracker.Web.Services.ErrorHandling
@using BudgetTracker.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject IApiClient ApiClient
@inject ApiErrorHandler ErrorHandler

<div class="auth-page">
    <div class="auth-card">
        <h2>Forgot Password</h2>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <ErrorAlert Message="@_errorMessage" />
        }

        @if (_emailSent)
        {
            <div class="alert alert-success">
                <p>If an account exists with that email, you will receive password reset instructions.</p>
                <a href="/login" class="btn btn-primary">Back to Login</a>
            </div>
        }
        else
        {
            <p class="help-text">Enter your email address and we'll send you instructions to reset your password.</p>

            <EditForm Model="@_forgotPasswordRequest" OnValidSubmit="@HandleForgotPassword">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group">
                    <label for="email">Email</label>
                    <InputText id="email" @bind-Value="_forgotPasswordRequest.Email" class="form-control" placeholder="Enter your email" />
                    <ValidationMessage For="@(() => _forgotPasswordRequest.Email)" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-block" disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <LoadingSpinner />
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>Send Reset Link</span>
                        }
                    </button>
                </div>
            </EditForm>

            <div class="auth-links">
                <a href="/login">Back to Login</a>
            </div>
        }
    </div>
</div>



@code {
    private ForgotPasswordRequest _forgotPasswordRequest = new();
    private bool _isLoading = false;
    private bool _emailSent = false;
    private string? _errorMessage;

    private async Task HandleForgotPassword()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            await ApiClient.ForgotPasswordAsync(_forgotPasswordRequest);
            _emailSent = true;
        }
        catch (Exception ex)
        {
            var result = ErrorHandler.Handle(ex, "Password reset request failed");
            _errorMessage = result.UserMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
