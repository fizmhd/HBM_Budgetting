@page "/reset-password"
@using BudgetTracker.Shared.DTOs.Auth
@using BudgetTracker.Web.Services
@using BudgetTracker.Web.Services.ErrorHandling
@using BudgetTracker.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject IApiClient ApiClient
@inject NavigationManager Navigation
@inject ApiErrorHandler ErrorHandler

<div class="auth-page">
    <div class="auth-card">
        <h2>Reset Password</h2>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <ErrorAlert Message="@_errorMessage" />
        }

        @if (_resetSuccess)
        {
            <div class="alert alert-success">
                <p>Your password has been reset successfully!</p>
                <a href="/login" class="btn btn-primary btn-block">Go to Login</a>
            </div>
        }
        else
        {
            <EditForm Model="@_resetPasswordRequest" OnValidSubmit="@HandleResetPassword">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <InputText id="newPassword" type="password" @bind-Value="_resetPasswordRequest.NewPassword" class="form-control" placeholder="Enter new password" />
                    <ValidationMessage For="@(() => _resetPasswordRequest.NewPassword)" />
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <InputText id="confirmPassword" type="password" @bind-Value="_confirmPassword" class="form-control" placeholder="Confirm new password" />
                    @if (!string.IsNullOrEmpty(_confirmPassword) && _resetPasswordRequest.NewPassword != _confirmPassword)
                    {
                        <div class="validation-message">Passwords do not match</div>
                    }
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-block" disabled="@(_isLoading || _resetPasswordRequest.NewPassword != _confirmPassword)">
                        @if (_isLoading)
                        {
                            <LoadingSpinner />
                            <span>Resetting...</span>
                        }
                        else
                        {
                            <span>Reset Password</span>
                        }
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>


@code {
    private ResetPasswordRequest _resetPasswordRequest = new();
    private string _confirmPassword = string.Empty;
    private bool _isLoading = false;
    private bool _resetSuccess = false;
    private string? _errorMessage;

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Token))
        {
            _resetPasswordRequest.Token = Token;
        }
        else
        {
            _errorMessage = "Invalid or missing reset token.";
        }
    }

    private async Task HandleResetPassword()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            await ApiClient.ResetPasswordAsync(_resetPasswordRequest);
            _resetSuccess = true;
        }
        catch (Exception ex)
        {
            var result = ErrorHandler.Handle(ex, "Password reset failed");
            _errorMessage = result.UserMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
