@page "/confirm-email"
@using BudgetTracker.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<div class="auth-page">
    <div class="auth-card">
        <h2>Email Confirmation</h2>

        @if (_isLoading)
        {
            <div class="text-center">
                <LoadingSpinner />
                <p>Confirming your email...</p>
            </div>
        }
        else if (_confirmationSuccess)
        {
            <div class="alert alert-success">
                <p>Your email has been confirmed successfully!</p>
                <a href="/login" class="btn btn-primary btn-block">Go to Login</a>
            </div>
        }
        else
        {
            <ErrorAlert Message="@_errorMessage" />
            <div class="auth-links">
                <a href="/login">Back to Login</a>
            </div>
        }
    </div>
</div>


@code {
    private bool _isLoading = true;
    private bool _confirmationSuccess = false;
    private string _errorMessage = "Email confirmation failed. The link may be invalid or expired.";

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Token))
        {
            _errorMessage = "Invalid confirmation link.";
            _isLoading = false;
            return;
        }

        // TODO: Implement email confirmation API call
        // For now, just simulate the confirmation
        await Task.Delay(1000);
        
        // This would be replaced with actual API call:
        // await ApiClient.ConfirmEmailAsync(new ConfirmEmailRequest { Token = Token });
        
        _confirmationSuccess = true;
        _isLoading = false;
    }
}
