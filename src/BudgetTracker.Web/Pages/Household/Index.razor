@page "/household"
@using BudgetTracker.Shared.DTOs.Households
@using BudgetTracker.Web.Services
@using BudgetTracker.Web.Services.ErrorHandling
@using BudgetTracker.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IApiClient ApiClient
@inject ApiErrorHandler ErrorHandler

<PageTitle>Household - Budget Tracker</PageTitle>

<div class="container py-4">
    <h1 class="h3 mb-4">Household</h1>

    @if (_isLoading)
    {
        <LoadingSpinner />
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <ErrorAlert Message="@_errorMessage" />
    }
    else if (_household is null)
    {
        <div class="alert alert-info">
            You don't belong to a household yet.
            <a href="/onboarding">Set one up</a>.
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h5 card-title mb-3">@_household.Name</h2>

                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Role</th>
                            <th>Joined</th>
                            @if (_isOwner)
                            {
                                <th class="text-end">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in _household.Members)
                        {
                            <tr>
                                <td>@member.DisplayName</td>
                                <td>
                                    <span class="badge @(member.Role == "Owner" ? "bg-primary" : "bg-secondary")">
                                        @member.Role
                                    </span>
                                </td>
                                <td>@member.JoinedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                @if (_isOwner)
                                {
                                    <td class="text-end">
                                        @if (member.Role != "Owner")
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => RemoveMember(member)"
                                                    disabled="@_isWorking">
                                                Remove
                                            </button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_isOwner)
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 card-title mb-3">Invite a member</h2>

                    @if (!string.IsNullOrEmpty(_actionError))
                    {
                        <div class="alert alert-danger">@_actionError</div>
                    }

                    <EditForm Model="@_inviteRequest" OnValidSubmit="SendInvite">
                        <div class="row g-2 align-items-end">
                            <div class="col-sm">
                                <label for="inviteEmail" class="form-label">Email</label>
                                <InputText id="inviteEmail" @bind-Value="_inviteRequest.Email"
                                           class="form-control" placeholder="spouse@example.com" />
                            </div>
                            <div class="col-sm-auto">
                                <button type="submit" class="btn btn-primary" disabled="@_isWorking">
                                    Send invite
                                </button>
                            </div>
                        </div>
                    </EditForm>

                    @if (_lastInvite is not null)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            <p class="mb-1">
                                Invite created for <strong>@_lastInvite.Email</strong>.
                                Share this link so they can join:
                            </p>
                            <code class="d-block text-break">@InviteLink(_lastInvite.Token)</code>
                            <small class="text-muted">Expires @_lastInvite.ExpiresAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm").</small>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private HouseholdDto? _household;
    private bool _isOwner;
    private Guid? _myUserId;
    private bool _isLoading = true;
    private bool _isWorking;
    private string? _errorMessage;
    private string? _actionError;

    private InviteMemberRequest _inviteRequest = new();
    private HouseholdInviteDto? _lastInvite;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var profile = await ApiClient.GetProfileAsync();
            _myUserId = profile?.Id;

            _household = await ApiClient.GetCurrentHouseholdAsync();
            _isOwner = _household?.Members.Any(m => m.UserId == _myUserId && m.Role == "Owner") ?? false;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            // No household yet.
            _household = null;
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorHandler.Handle(ex, "Failed to load household").UserMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SendInvite()
    {
        if (_household is null || string.IsNullOrWhiteSpace(_inviteRequest.Email))
        {
            return;
        }

        _isWorking = true;
        _actionError = null;
        try
        {
            _lastInvite = await ApiClient.InviteMemberAsync(_household.Id, _inviteRequest);
            _inviteRequest = new();
        }
        catch (Exception ex)
        {
            _actionError = ErrorHandler.Handle(ex, "Failed to create invite").UserMessage;
        }
        finally
        {
            _isWorking = false;
        }
    }

    private async Task RemoveMember(HouseholdMemberDto member)
    {
        if (_household is null)
        {
            return;
        }

        _isWorking = true;
        _actionError = null;
        try
        {
            await ApiClient.RemoveMemberAsync(_household.Id, member.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ErrorHandler.Handle(ex, "Failed to remove member").UserMessage;
        }
        finally
        {
            _isWorking = false;
        }
    }

    private string InviteLink(string token) =>
        $"{Navigation.BaseUri.TrimEnd('/')}/join/{token}";
}
