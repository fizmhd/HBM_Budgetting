@page "/onboarding"
@using BudgetTracker.Shared.DTOs.Users
@using BudgetTracker.Web.Services
@using BudgetTracker.Web.Services.ErrorHandling
@using BudgetTracker.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IApiClient ApiClient
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ApiErrorHandler ErrorHandler

<div class="auth-page">
    <div class="auth-card">
        <h2>Welcome! Complete Your Profile</h2>
        <p class="help-text">Please provide some basic information to get started.</p>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <ErrorAlert Message="@_errorMessage" />
        }

        <EditForm Model="@_completeProfileRequest" OnValidSubmit="@HandleCompleteProfile">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="firstName">First Name *</label>
                <InputText id="firstName" @bind-Value="_completeProfileRequest.FirstName" class="form-control" placeholder="Enter your first name" />
                <ValidationMessage For="@(() => _completeProfileRequest.FirstName)" />
            </div>

            <div class="form-group">
                <label for="lastName">Last Name *</label>
                <InputText id="lastName" @bind-Value="_completeProfileRequest.LastName" class="form-control" placeholder="Enter your last name" />
                <ValidationMessage For="@(() => _completeProfileRequest.LastName)" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-block" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <LoadingSpinner />
                        <span>Completing Setup...</span>
                    }
                    else
                    {
                        <span>Complete Setup</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>



@code {
    private CompleteProfileRequest _completeProfileRequest = new();
    private bool _isLoading = false;
    private string? _errorMessage;

    private async Task HandleCompleteProfile()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await ApiClient.CompleteProfileAsync(_completeProfileRequest);

            if (result != null)
            {
                // Refresh authentication state
                if (AuthStateProvider is BudgetTracker.Web.Auth.AuthStateProvider provider)
                {
                    provider.NotifyAuthenticationStateChanged();
                }

                // Navigate to home
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                _errorMessage = "Failed to complete profile. Please try again.";
            }
        }
        catch (Exception ex)
        {
            var result = ErrorHandler.Handle(ex, "Profile completion failed");
            _errorMessage = result.UserMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
