@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var currentUri = Navigation.Uri;
        var loginUri = Navigation.ToAbsoluteUri("/login").ToString();
        
        // Only redirect if not already on the login page to prevent infinite loop
        if (!currentUri.StartsWith(loginUri, StringComparison.OrdinalIgnoreCase))
        {
            var returnUrl = Uri.EscapeDataString(currentUri);
            Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: true);
        }
        else
        {
            // Already on login page, just navigate to login without returnUrl
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}
