@using BudgetTracker.Shared.DTOs.Categories
@using BudgetTracker.Web.Services
@inject IApiClient ApiClient

@*
    Reusable hierarchical category picker (TASK 3.4).
    Selectable rule: a leaf category (including a "leaf parent" with no children) is selectable;
    a parent that still has children is shown but disabled (it only groups its children).
    Bindable via @bind-SelectedCategoryId.
*@

<select class="form-select @CssClass" value="@SelectedCategoryId" @onchange="OnChanged" disabled="@Disabled">
    @if (AllowClear)
    {
        <option value="">@ClearLabel</option>
    }
    else if (SelectedCategoryId is null)
    {
        <option value="" disabled selected>Select a category…</option>
    }

    @foreach (var row in _rows)
    {
        <option value="@row.Id" disabled="@(!row.Selectable)">
            @(new string(' ', row.Depth * 3))@(row.Selectable ? "" : "• ")@row.Name
        </option>
    }
</select>

@code {
    private sealed record Row(Guid Id, string Name, int Depth, bool Selectable);

    private readonly List<Row> _rows = new();

    [Parameter] public Guid? SelectedCategoryId { get; set; }
    [Parameter] public EventCallback<Guid?> SelectedCategoryIdChanged { get; set; }

    /// <summary>When true, an explicit "no category" option is offered.</summary>
    [Parameter] public bool AllowClear { get; set; }

    [Parameter] public string ClearLabel { get; set; } = "— None —";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Optional pre-loaded tree. When supplied the picker does not call the API itself — useful when a
    /// parent page already holds the tree (e.g. many pickers in a split editor).
    /// </summary>
    [Parameter] public List<CategoryTreeNodeDto>? Tree { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Tree is not null)
        {
            Rebuild(Tree);
        }
        else if (_rows.Count == 0)
        {
            var tree = await ApiClient.GetCategoryTreeAsync() ?? new();
            Rebuild(tree);
        }
    }

    private void Rebuild(List<CategoryTreeNodeDto> tree)
    {
        _rows.Clear();
        foreach (var node in tree)
        {
            Add(node, 0);
        }
    }

    private void Add(CategoryTreeNodeDto node, int depth)
    {
        // A parent with children is a grouping node and not directly selectable.
        _rows.Add(new Row(node.Id, node.Name, depth, node.IsLeaf));
        foreach (var child in node.Children)
        {
            Add(child, depth + 1);
        }
    }

    private async Task OnChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        Guid? value = Guid.TryParse(raw, out var id) ? id : null;
        SelectedCategoryId = value;
        await SelectedCategoryIdChanged.InvokeAsync(value);
    }
}
